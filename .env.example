# Copy to .env and fill in values
# Required for standalone Docker / local dev (Add-on context uses SUPERVISOR_TOKEN)

# Home Assistant connection
HA_URL=http://localhost:8123
HA_TOKEN=

# Server
PORT=3000
LOG_LEVEL=debug

# SQLite database location
DATA_DIR=./data

# Tier 2 — AI features (all optional, defaults shown)
AI_ENABLED=false
AI_PROVIDER=ollama
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=http://localhost:11434
AI_CONFIDENCE_THRESHOLD=0.5
AI_MAX_COST_PER_RUN_USD=0.10
AI_MAX_CALLS_PER_RUN=50
