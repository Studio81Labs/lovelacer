# Build outputs that we recreate inside the container
**/dist
**/node_modules
**/.tsbuildinfo

# Worktrees, git, IDE
.worktrees
.git
.github
.vscode
.idea

# Tests + dev infrastructure
**/__tests__
**/*.test.ts
**/tests
dev
docs

# Addon assets that aren't part of the build context (the Dockerfile
